{
  "name": "@presenca/db",
  "version": "0.0.0",
  "private": true,
  "description": "Schema Drizzle, migrations e acesso ao PostgreSQL. Importado SOMENTE por apps/api e apps/worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./testing": {
      "types": "./dist/testing/harness.d.ts",
      "default": "./dist/testing/harness.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "pnpm build && node dist/cli/migrate.js",
    "db:seed": "pnpm build && node dist/cli/seed.js",
    "db:studio": "drizzle-kit studio",
    "verify:roles": "node scripts/verify-roles.mjs",
    "db:check": "node scripts/check-drift.mjs",
    "db:provision": "pnpm build && node dist/cli/provision.js",
    "db:backup-role": "pnpm build && node dist/cli/backup-role.js"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
