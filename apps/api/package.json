    "@nestjs/platform-fastify": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@presenca/contracts": "workspace:*",
    "@presenca/db": "workspace:*",
    "@presenca/emails": "workspace:*",
    "@presenca/engine": "workspace:*",
    "@presenca/integrations": "workspace:*",
    "@presenca/observability": "workspace:*",
    "arctic": "catalog:",
    "drizzle-orm": "catalog:",
    "exceljs": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
