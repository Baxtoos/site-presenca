{
  "name": "@presenca/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST (NestJS + Fastify): única porta de entrada para os dados.",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
