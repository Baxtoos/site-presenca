{
  "name": "@presenca/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Processo separado: entrega os avisos do outbox (e-mail, push), gera lembretes de chamada e limpa dados expirados.",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@presenca/contracts": "workspace:*",
    "@presenca/db": "workspace:*",
    "@presenca/emails": "workspace:*",
    "@presenca/engine": "workspace:*",
    "@presenca/integrations": "workspace:*",
    "@presenca/observability": "workspace:*",
    "pg": "catalog:",
    "web-push": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/web-push": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
