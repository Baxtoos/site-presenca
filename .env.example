# Copie para .env na raiz:  cp .env.example .env
# Valores abaixo servem só para desenvolvimento local com infra/docker-compose.yml.

NODE_ENV=development

# Web (Next.js) -> API. O navegador nunca recebe credenciais de banco.
API_INTERNAL_URL=http://localhost:4000

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Papel app_api: só DML, sujeito a RLS, sem DDL.
DATABASE_URL=postgres://app_api:app_api_dev@localhost:5432/presenca
REDIS_URL=redis://localhost:6379
# Proxies confiáveis para X-Forwarded-For: false, número de saltos ou lista de IPs. Nunca true em produção.
TRUST_PROXY=false

# Migrations: papel dono do schema. Usado só pelo drizzle-kit e pelo job de deploy.
DATABASE_URL_OWNER=postgres://app_owner:app_owner_dev@localhost:5432/presenca

# Worker: papel app_worker.
WORKER_DATABASE_URL=postgres://app_worker:app_worker_dev@localhost:5432/presenca
WORKER_POLL_INTERVAL_MS=30000

# E-mail em desenvolvimento cai no Mailpit (http://localhost:8025).
SMTP_URL=smtp://localhost:1025
