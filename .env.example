# Copie para .env na raiz:  cp .env.example .env
# Valores abaixo servem só para desenvolvimento local com infra/docker-compose.yml.

NODE_ENV=development

# Web (Next.js) -> API. O navegador nunca recebe credenciais de banco.
API_INTERNAL_URL=http://localhost:4000

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Papel app_api: só DML, sujeito a RLS, sem DDL.
DATABASE_URL=postgres://app_api:app_api_dev@localhost:5432/presenca
REDIS_URL=redis://localhost:6379
# Proxies confiáveis para X-Forwarded-For: false, número de saltos ou lista de IPs. Nunca true em produção.
TRUST_PROXY=false
# Segredo compartilhado site ↔ API para repassar o IP real do aluno (produção). Vazio = desligado.
API_PROXY_SECRET=
# fatal | error | warn | info | debug | trace | silent  (em development os logs saem formatados)
LOG_LEVEL=info
# Publica /openapi.json. Sem valor: ligado fora de produção, desligado em produção.
OPENAPI_ENABLED=
# Versão exibida em /healthz e nos logs (o deploy define com o commit ou a tag).
# Versão publicada. Vazio: usa o commit do deploy (RENDER_GIT_COMMIT no Render) ou "dev".
# APP_VERSION=
# Multiplica os limites de tentativa. Em desenvolvimento e nos testes E2E tudo sai do mesmo IP
# (localhost), então afrouxa 10×. Em produção a API exige 1.
RATE_LIMIT_FACTOR=10

# Migrations: papel dono do schema. Usado só pelo drizzle-kit e pelo job de deploy.
DATABASE_URL_OWNER=postgres://app_owner:app_owner_dev@localhost:5432/presenca

# Worker: papel app_worker.
WORKER_DATABASE_URL=postgres://app_worker:app_worker_dev@localhost:5432/presenca
WORKER_POLL_INTERVAL_MS=30000

# ---- Web Push (opcional: sem as chaves, o app não oferece push) ----
# Gere um par com: pnpm --filter @presenca/worker exec web-push generate-vapid-keys
# A pública vai para a API (repassada ao navegador); a privada fica SÓ no worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nao-responda@presenca.local

# E-mail: smtp (Mailpit em desenvolvimento, http://localhost:8025), resend, relay (a API entrega
# ao app web, que envia por SMTP; para o Render gratuito, que bloqueia SMTP) ou log.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Monitor de Presenças <nao-responda@presenca.local>"
RESEND_API_KEY=

# Login com Google (opcional). Sem as duas, o botão leva a uma mensagem de indisponível.
# Retorno a cadastrar no Google Cloud: <WEB_ORIGIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recusa senhas que aparecem em vazamentos (Have I Been Pwned, por k-anonimato). Padrão: ligado.
HIBP_ENABLED=

# Rastreamento de erros (Sentry). Vazio = desligado. No site: NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
